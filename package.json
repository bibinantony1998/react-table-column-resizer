{
  "name": "react-table-column-resizer",
  "version": "2.0.1",
  "description": "Place in between `td` tags to automatically add resizing functionality.",
  "keywords": [
    "Table column resize",
    "react table column resize",
    "html table column resize",
    "table resize component",
    "Table column resize react",
    "column resize",
    "react",
    "html",
    "table",
    "column",
    "auto",
    "resize"
  ],
  "author": "Bibin antony",
  "main": "dist/cjs/column-resizer.js",
  "module": "dist/esm/column-resizer.js",
  "types": "./dist/column-resizer.d.ts",
  "scripts": {
    "clean:dist": "rm -rf dist",
    "build:cjs": "babel src -d dist/cjs --extensions \".js,.jsx,.ts,.tsx\" --env-name cjs",
    "build:esm": "babel src -d dist/esm --extensions \".js,.jsx,.ts,.tsx\" --env-name esm",
    "build": "npm run clean:dist && npx tsc src/column-resizer.tsx --jsx react-jsx --declaration --emitDeclarationOnly --outDir dist && npm run build:cjs && npm run build:esm",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "start": "react-scripts start",
    "eject": "react-scripts eject",
    "deploy": "gh-pages -d dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/column-resizer.d.ts",
    "README.md",
    "license.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibinantony1998/react-table-column-resizer"
  },
  "license": "ISC",
  "homepage": "https://github.com/bibinantony1998/react-table-column-resizer#readme",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.0",
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.20.0",
    "@babel/preset-typescript": "^7.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.1.4",
    "babel-core": "^7.0.0-bridge.0",
    "babel-loader": "^8.2.0",
    "cheerio": "^1.0.0-rc.10",
    "jsdom": "^26.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.4",
    "vitest": "^3.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "private": false,
  "exports": {
    ".": {
      "import": "./dist/esm/column-resizer.js",
      "require": "./dist/cjs/column-resizer.js"
    }
  }
}
